# ==========================================
# Audio & Raw Media Files
# ==========================================
data/**/*.wav
data/**/*.flac
data/**/*.mp3
data/**/*.m4a
data/**/*.ogg
!data/**/.gitkeep
data/mixed/
data/phase3_sample_dataset/
data/mt/flores200_dataset.tar.gz
data/mt/raw/
outputs/

# ==========================================
# Python & Bytecode Caches
# ==========================================
**/__pycache__/
*.py[cod]
.ipynb_checkpoints/
.vscode/
venv_pipeline/
=*.*.*
*.tmp
third_party/**/*.tmp
*.exe

# ==========================================
# OS Generated Files
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Heavy Model Weights & Binary Contexts
# ==========================================
*.onnx
*.onnx.data
*.npz
*.dlc
*.bin
*.pkl

# Preserve required static runtime assets in s2s_edge
!s2s_edge/assets/**
!s2s_edge/assets/*.npz
!s2s_edge/assets/*.npy

# ==========================================
# Third-party & Legacy Step 4 Caches
# ==========================================
third_party/zipformer/
src/**/*.onnx
src/**/*.onnx.json
src/step4_quantization/asr/asr_batch_logs/
src/step4_quantization/mt/mt_batch_logs/
src/step4_quantization/mt/nllb/work/*.onnx
src/step4_quantization/mt/nllb/work/hw_*.npy
src/step4_quantization/tts/tts_generated_audio/
