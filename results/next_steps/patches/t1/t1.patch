+            if "__pycache__" in p.parts or ".cache" in p.parts or "source" in p.parts:
+                continue
+            if p.suffix in (".py", ".json", ".crfsuite") or p.name in ("models.cpu.json", "manifest.json"):
+                out.append(p)
+    return out
