+import argparse, os, sys, subprocess, time, urllib.request, json
+
+root = Path(__file__).resolve().parents[1]
+if str(root / "s2s_edge") not in sys.path:
+    sys.path.insert(0, str(root / "s2s_edge"))
+
+
+def build_launch_env(base_env=None):
+    """Build subprocess env honoring caller S2S_NEURAL_TN/VAD/ORT/TTS settings without forcing 1 over 0."""
+    env = dict(os.environ if base_env is None else base_env)
+    env.setdefault("S2S_NEURAL_TN", "1")
+    env.setdefault("S2S_TTS_FORMAT", "hybrid")
+    env.setdefault("S2S_VAD_PROFILE", "legacy")
+    env.setdefault("S2S_ORT_POLICY", "auto")
+    env.setdefault("HF_HOME", "/private/tmp/s2s-hf")
+    from s2s_edge.registry import resolve_runtime_profile
+    resolve_runtime_profile(
+        vad_profile=env.get("S2S_VAD_PROFILE"),
+        ort_policy=env.get("S2S_ORT_POLICY"),
+        source_mode=env.get("S2S_NEURAL_TN"),
+        tts_format=env.get("S2S_TTS_FORMAT"),
+    )
+    return env
+
+
+def ready(url):
+    try:
+        with urllib.request.urlopen(url + "/api/health", timeout=2) as r:
+            return json.load(r).get("ok") is True
+    except Exception:
+        return False
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="Start the OneVoice web server.")
+    ap.add_argument("--port", type=int, default=8766)
+    ap.add_argument("--out-dir", default=None)
+    ap.add_argument("--log-file", default=None)
+    args = ap.parse_args(argv)
+    url = f"http://localhost:{args.port}"
+    if not ready(url):
+        env = build_launch_env()
+        cmd = [sys.executable, "-u", str(root / "tools/s2s_web.py"), "--port", str(args.port)]
+        if args.out_dir:
+            cmd.extend(["--out-dir", str(args.out_dir)])
+        log_path = Path(args.log_file) if args.log_file else (root / "logs/s2s_web.log")
+        log_path.parent.mkdir(parents=True, exist_ok=True)
+        with log_path.open("a") as f:
+            p = subprocess.Popen(cmd, cwd=str(root), env=env, stdin=subprocess.DEVNULL, stdout=f, stderr=subprocess.STDOUT, start_new_session=True)
+        if args.port == 8766 and not args.out_dir:
+            pid_path = root / "results/mic_web/server.pid"
+            pid_path.parent.mkdir(parents=True, exist_ok=True)
+            pid_path.write_text(str(p.pid))
+        for _ in range(40):
+            if ready(url):
+                break
+            if p.poll() is not None:
+                raise RuntimeError(f"Web server exited; inspect {log_path}")
+            time.sleep(0.25)
+        if not ready(url):
+            raise RuntimeError("Web server did not become ready")
+    print(url)
+
+
+if __name__ == "__main__":
+    main()
